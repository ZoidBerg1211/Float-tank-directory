# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables / secrets
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Supabase local runtime state (config.toml, migrations, functions ARE committed)
supabase/.branches/
supabase/.temp/

# Build output
dist/
build/
.next/
out/

# Generated pages (regenerated from Supabase by scripts/build-listings.js —
# never hand-edit these; index.html/sitemap.xml/robots.txt used to be static
# but are now build output driven by real listing data)
listings/
/index.html
/float/
/sitemap.xml
/robots.txt

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS junk
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Editor/IDE settings (kept local-only per project convention)
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code — personal/local overrides only.
# .claude/settings.json IS committed (shared team config, e.g. the secret-file
# read-deny rule); settings.local.json is per-machine and never committed.
.claude/settings.local.json

# Agent Skills symlinks: these point at an absolute, machine-specific path and
# this repo has core.symlinks=false, so committing them would give teammates a
# broken text file instead of a working symlink. The real content lives in
# .agents/skills/ (committed, portable); regenerate this local symlink layer
# after cloning with `npx skills experimental_install`.
.claude/skills/
